# Copie para .env e preencha. O .env NUNCA vai para o Git nem para a pasta public.
APP_ENV=local                # local | production
APP_URL=http://localhost:8000
APP_HOST=erp.atczanardicontabilidade.com.br
TRUST_CLOUDFLARE=false       # true só se o subdomínio passar pelo proxy do Cloudflare

# Banco do ERP (leitura e escrita)
ERP_DB_HOST=localhost
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASS=

# Banco do app ATC Zanardi (SOMENTE LEITURA)
APP_DB_HOST=localhost
APP_DB_NAME=
APP_DB_USER=
APP_DB_PASS=

# Mapeamento da tabela de usuários do app (confirmar inspecionando o banco do app)
APP_USERS_TABLE=usuarios
APP_COL_ID=id
APP_COL_LOGIN=email          # coluna usada no login do app (e-mail, usuário ou CPF)
APP_COL_NAME=nome
APP_COL_EMAIL=email
APP_COL_PASSWORD=senha
APP_COL_ACTIVE=              # deixe vazio se o app não tiver coluna de ativo
APP_PASSWORD_ALGO=password_hash   # password_hash | md5 | sha1 (conforme o app grava)

# SSO a partir do app (mesmo valor no .env do app). Gerar com: php -r "echo bin2hex(random_bytes(32));"
SSO_SECRET=

SESSION_TIMEOUT_MIN=120
